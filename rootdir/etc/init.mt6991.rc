on early-init
    # boot time fs tuning
    write /proc/sys/kernel/perf_cpu_time_max_percent 5

on init
    # Set up health hal
    wait /dev/block/platform/bootdevice
    symlink /dev/block/platform/bootdevice/by-name /dev/block/by-name

    # Init subsystem devices
    chmod 0660 /dev/snd/controlC0
    chown root audio /dev/snd/controlC0

    # Boost EAS
    write /proc/sys/kernel/sched_util_clamp_min 128
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 128

on early-boot
    # Set default tcp rmem/wmem buffers
    write /proc/sys/net/ipv4/tcp_rmem "4096 87380 8388608"
    write /proc/sys/net/ipv4/tcp_wmem "4096 87380 8388608"
    write /proc/sys/net/core/rmem_default 327680
    write /proc/sys/net/core/rmem_max 8388608
    write /proc/sys/net/core/wmem_default 327680
    write /proc/sys/net/core/wmem_max 8388608

on boot
    # Graphics
    chown root system /proc/gpufreq/gpufreq_opp_dump
    chmod 0775 /proc/gpufreq/gpufreq_opp_dump
    chown root system /proc/gpufreq/gpufreq_cur_freq
    chmod 0775 /proc/gpufreq/gpufreq_cur_freq

    # Modem device
    chown root radio /dev/ccci_ipc_1
    chmod 0660 /dev/ccci_ipc_1

    # Bluetooth
    chown root bluetooth /dev/hid-keyboard
    chmod 0660 /dev/hid-keyboard

    # NFC
    chmod 0660 /dev/pn553
    chown nfc nfc /dev/pn553

    # AGPS
    setprop ro.vendor.agps.supported 1

    # Touchpanel
    chmod 0664 /proc/touchpanel/tp_fw_update
    chown system system /proc/touchpanel/tp_fw_update

    # Fingerprint
    chmod 0666 /dev/goodix_fp
    chown system system /dev/goodix_fp

    # Boostpulse
    chmod 0664 /sys/devices/platform/17000000.mt8195-larb/power/autosuspend_delay_ms
    chown system system /sys/devices/platform/17000000.mt8195-larb/power/autosuspend_delay_ms

    # Camera
    chmod 0660 /dev/MAINAF
    chown system camera /dev/MAINAF

on post-fs-data
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/tcpdump 0770 tcpdump wifi
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

    # NFC
    mkdir /data/nfc 0770 nfc nfc
    mkdir /data/vendor/nfc 0770 nfc nfc

    # Modem
    mkdir /data/vendor/modem_temp 0770 radio radio

    # GPS
    mkdir /data/vendor/gps 0770 gps gps
    mkdir /data/vendor/gps/emi 0770 gps gps

on property:sys.boot_completed=1
    # Runtime fs tuning
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/dirty_ratio 5
    write /proc/sys/vm/dirty_background_ratio 2
    write /proc/sys/vm/dirty_expire_centisecs 200
    write /proc/sys/vm/dirty_writeback_centisecs 0

    # mtk scheduler
    write /proc/sys/kernel/sched_migration_cost_ns 5000000
    write /proc/sys/kernel/sched_min_task_util_for_colocation 200

    # Swap
    swapon_all /vendor/etc/fstab.mt6991

service vendor.mtk-ril-daemon /vendor/bin/rilproxy
    class main
    socket rild stream 660 root radio
    socket rild-debug stream 660 radio system
    socket rild1 stream 660 root radio
    socket rild-debug1 stream 660 radio system
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log
    disabled

service vendor.cig_mdm /vendor/bin/cig_mdm
    class core
    user root
    group radio
    disabled

service vendor.thermal-engine /vendor/bin/thermal-engine
    class main
    user root
    socket thermal-manager stream 0660 root system
    socket thermal-monitor stream 0666 root system
    group root radio shell system

service vendor.mtk-agpsd /vendor/bin/mtk-agpsd
    class main
    user gps
    group gps radio

service vendor.wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1p2p_device=1 \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant  default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant  default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant  default
    interface android.hardware.wifi.supplicant@1.3::ISupplicant  default
    socket wpa_wlan0 dgram 660 wifi wifi
    class main
    disabled
    oneshot
